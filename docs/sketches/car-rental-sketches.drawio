r=none;strokeWidth=1;fontSize=12;fontColor=#282828;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2536" y="518" width="428" height="18" as="geometry"/></mxCell><mxCell id="c180" value="Create rental" style="html=1;whiteSpace=wrap;fillColor=#FFD646;strokeColor=#282828;strokeWidth=1.5;rounded=1;absoluteArcSize=1;arcSize=12;fontSize=13;fontColor=#282828;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2516" y="546" width="129.0" height="32" as="geometry"/></mxCell><mxCell id="c181" value="all fields valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#1F3864;fontColor=#1F3864;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c84" target="c86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c182" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#1F3864;fontColor=#1F3864;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c103" target="c106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c183" value="licence missing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#C82828;fontColor=#C82828;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c84" target="c127"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100.5" y="634"/><mxPoint x="2120.0" y="634"/></Array></mxGeometry></mxCell><mxCell id="c184" value="category full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#C82828;fontColor=#C82828;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c84" target="c154"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100.5" y="658"/><mxPoint x="2740.0" y="658"/></Array></mxGeometry></mxCell><mxCell id="c185" value="&lt;b&gt;Missing details we found&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Our workflow did not say how Marco finds a returning customer. He retypes the name and licence each time.&lt;br&gt;• The workflow did not show where Marco sees whether a car is ready. We added the Overview screen.&lt;br&gt;• The workflow table had a &amp;quot;no car free&amp;quot; case, but no screen for it. We added it.&lt;br&gt;• It was unclear what happens if Marco picks the wrong car after submitting." style="shape=note;size=18;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20.0" y="698" width="1465.0" height="128" as="geometry"/></mxCell><mxCell id="c186" value="&lt;b&gt;Group decisions&lt;/b&gt;&lt;br&gt;&lt;br&gt;• One customer and one car per rental in the first version.&lt;br&gt;• The Overview lists today's rentals by pickup time with their status. Marco hands over the keys from there.&lt;br&gt;• Only free cars appear. If a category is full, the app suggests free cars from other categories.&lt;br&gt;• No editing after submitting in version 1. Changing or cancelling comes later." style="shape=note;size=18;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1515.0" y="698" width="1465.0" height="128" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Luca · Bring 