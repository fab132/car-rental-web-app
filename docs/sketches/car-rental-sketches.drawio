6" y="244" width="448" height="18" as="geometry"/></mxCell><mxCell id="c256" value="New rentals appear here automatically." style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#8C8C8C;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1896" y="262" width="448" height="16" as="geometry"/></mxCell><mxCell id="c257" value="Refresh" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#282828;strokeWidth=1.5;rounded=1;absoluteArcSize=1;arcSize=12;fontSize=13;fontColor=#282828;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1896" y="298" width="88.6875" height="32" as="geometry"/></mxCell><mxCell id="c258" value="tap rental" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#1F3864;fontColor=#1F3864;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c201" target="c206"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c259" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#1F3864;fontColor=#1F3864;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c223" target="c226"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c260" value="&lt;b&gt;Missing details we found&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Luca needs the parking spot, otherwise he searches the whole yard. We added it to the queue and the details.&lt;br&gt;• The workflow did not define the order of the queue.&lt;br&gt;• It is open what Luca does if the car is damaged or not at its spot." style="shape=note;size=18;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20.0" y="568" width="1155.0" height="110" as="geometry"/></mxCell><mxCell id="c261" value="&lt;b&gt;Group decisions&lt;/b&gt;&lt;br&gt;&lt;br&gt;• The queue is sorted by pickup time, earliest first.&lt;br&gt;• A rental leaves the queue once Luca marks it &amp;quot;Ready&amp;quot;.&lt;br&gt;• Reporting a problem with the car stays out of version 1. Luca tells Marco directly for now." style="shape=note;size=18;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1205.0" y="568" width="1155.0" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Nina · Check status" id="d7802466356714046215"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c262" value="Sketch 3: Nina checks her car status (phone)" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#1F3864;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c263" value="1 · Input" style="html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=15;fontColor=#1F3864;align=left;verticalAlign=middle;spacingLeft=0;spacingTop=0;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="280" height="26" as="geometry"/></mxCell><mxCell id="c264" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#282828;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=20;fontSize=12;fontColo