          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c53" edge="1" parent="1" source="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#C82828;fontColor=#C82828;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="c34" value="licence missing">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="106" y="580" />
              <mxPoint x="1100" y="580" />
            </Array>
          </mxGeometry>
